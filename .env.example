APP_NAME=first-ai-agent
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./agentops.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_BYTES=10485760
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
PORT=8000
HOST=0.0.0.0
WORKERS=1

# Semantic index (Neural Engine / CPU). none | hash | sentence | coreml | auto
INFERENCE_BACKEND=auto
EMBED_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBED_BATCH_SIZE=32
EMBED_VECTOR_DIMS=384
